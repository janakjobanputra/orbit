// Cloudflare deploys the website in site/ from this repo on every push to main.
// site-worker.js handles /download; everything else is served straight from site/.
{
  "name": "orbit",
  "main": "site-worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "try-orbit.app", "custom_domain": true },
    { "pattern": "www.try-orbit.app", "custom_domain": true }
  ]
}
